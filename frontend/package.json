{
	"name": "frontend",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check:lint": "biome lint .",
